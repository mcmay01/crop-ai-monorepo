{
  "name": "crop-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/mobile"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:ai": "cd apps/ai-service && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "npm run migrate --workspace=apps/backend",
    "db:studio": "npm run studio --workspace=apps/backend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
